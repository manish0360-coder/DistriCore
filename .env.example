# DistriCore environment configuration
# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env (N-11).
# Every variable the application reads appears here (00 §9.1).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DISTRICORE_ENV=development                 # development | test | production
DISTRICORE_DEBUG=true                      # MUST be false in production

# --- Security (no defaults in production) -----------------------------------
DISTRICORE_SECRET_KEY=dev-insecure-change-me-0000000000000000000000000000
DISTRICORE_ALLOWED_HOSTS=localhost,127.0.0.1
DISTRICORE_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# --- Public identity (production) -------------------------------------------
# The name Caddy obtains a TLS certificate for, and the name the mobile app is
# built against. Unset in development; **required by compose.prod.yml**, which
# refuses to start without it rather than serving an untrusted `localhost`
# certificate for a domain you have already bought (A-04).
#
# In production this must agree with the two lines above: the domain belongs in
# DISTRICORE_ALLOWED_HOSTS, and `https://<domain>` in
# DISTRICORE_CSRF_TRUSTED_ORIGINS. Three places, one name.
DISTRICORE_DOMAIN=

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://districore:districore@db:5432/districore
POSTGRES_DB=districore
POSTGRES_USER=districore
POSTGRES_PASSWORD=districore
# Persistent connection lifetime. Read by `config/settings/base.py` and absent from this
# file until M11.2 — `00` §9.1 says every variable the application reads appears here, and
# the contract that now enforces that could not be written while one did not.
DISTRICORE_DB_CONN_MAX_AGE=60

# --- Authentication ---------------------------------------------------------
DISTRICORE_ACCESS_TOKEN_MINUTES=30
DISTRICORE_REFRESH_TOKEN_DAYS=30
DISTRICORE_OTP_LENGTH=6
DISTRICORE_OTP_EXPIRY_MINUTES=10
DISTRICORE_OTP_MAX_ATTEMPTS=5
DISTRICORE_OTP_RETENTION_HOURS=24

# --- SMS / OTP provider (A-02; DLT registration required in India) ----------
DISTRICORE_SMS_PROVIDER=console            # console | msg91
DISTRICORE_SMS_API_KEY=
DISTRICORE_SMS_SENDER_ID=
DISTRICORE_SMS_TEMPLATE_ID=

# --- Storage ----------------------------------------------------------------
DISTRICORE_MEDIA_ROOT=/srv/media
DISTRICORE_MAX_UPLOAD_MB=5

# --- Logging (00 §12) -------------------------------------------------------
DISTRICORE_LOG_LEVEL=INFO                  # DEBUG|INFO|WARNING|ERROR|CRITICAL
DISTRICORE_LOG_FORMAT=console              # console (dev) | json (production)

# --- Monitoring (00 §13) ----------------------------------------------------
SENTRY_DSN=
DISTRICORE_SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Backup health (surfaced by /healthz) -----------------------------------
# These paths are read INSIDE the app container, from the backup_data volume. The ops
# scripts write them there through `docker compose exec app` — they used to write the same
# paths on the host, which is a different filesystem, so /healthz could never see them.
DISTRICORE_BACKUP_STAMP_PATH=/srv/backups/last_success
DISTRICORE_BACKUP_MAX_AGE_HOURS=26
DISTRICORE_DISK_WARN_PERCENT=85

# --- Recovery readiness (NFR-AVA-001: RPO <= 15 min, RTO <= 4 h) -------------
# The requirement, in seconds. /healthz reports the measured offsite WAL lag against it.
# NOT a tuning knob: docs/M11.2_Recovery_Report.md derives archive_timeout (300 s, in
# docker/compose.yml) and the WAL shipping period (5 min, in ops/districore-wal-ship.timer)
# from this number, and a contract asserts the three still agree.
DISTRICORE_RPO_TARGET_SECONDS=900
# Two archive_timeout periods. Older, and PostgreSQL has stopped feeding the archive.
DISTRICORE_WAL_ARCHIVE_MAX_AGE_SECONDS=600
# Written only after the remote has been listed back and every segment proven present.
DISTRICORE_WAL_STAMP_PATH=/srv/backups/wal_offsite_last_success
DISTRICORE_WAL_OFFSITE_MAX_AGE_SECONDS=900
# How long a verified-offsite segment stays on this host, for a PITR with no download.
DISTRICORE_WAL_LOCAL_KEEP_HOURS=48
# The PITR anchor. Weekly base backup plus a day of slack.
DISTRICORE_BASEBACKUP_STAMP_PATH=/srv/backups/basebackup_last_success
DISTRICORE_BASEBACKUP_MAX_AGE_HOURS=192
DISTRICORE_BASEBACKUP_KEEP=3

# --- Backup transport (production only; empty locally) ----------------------
# **In production these two are mandatory and the scripts refuse to run without them.**
# ops/backup.sh, ops/ship-wal.sh and ops/basebackup.sh each exit non-zero and write no
# success stamp if either is unset: unencrypted data must not leave the host (B-2) and a
# backup that never leaves it does not survive losing it (B-7). A warning is not a control.
DISTRICORE_BACKUP_PASSPHRASE=
DISTRICORE_BACKUP_REMOTE=
DISTRICORE_BACKUP_KEEP_DAYS=7
# Host staging for the nightly dump. Encrypted before anything leaves this directory, and
# deliberately NOT the same path as the stamp above, which lives in the container volume.
DISTRICORE_BACKUP_DIR=/var/backups/districore
