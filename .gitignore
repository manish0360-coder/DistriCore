# Secrets — N-11. Never relax these.
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Django
/backend/media/
/backend/staticfiles/
*.sqlite3

# Session scratchpad — non-authoritative, disposable (ADR-0005 §5.4)
docs/_session/NOTES.md
.verify-result

# Ops
/backups/
.backups/
*.dump
# The ENCRYPTED archive too. `*.dump` does not match `*.dump.gpg`, and the B-3
# rehearsal writes exactly that — a full database in the working tree, one
# `git add -A` from source control. Encryption is not a reason to relax this:
# NFR-SEC-007 is about what is committed, and S-07's passphrase lives in a
# password manager that a repository clone does not carry.
*.dump.gpg

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Flutter (M8)
# `make dev-ca` writes Caddy's development root CA here. It is a per-machine development
# artefact regenerated whenever the `caddy_data_dev` volume is recreated — not a secret to
# guard, but not a repository fact either, and a committed certificate is one somebody
# later trusts for the wrong reason.
/build/

/mobile/build/
/mobile/.dart_tool/
# Android build outputs. `mobile/android/` itself IS committed — it is the platform
# scaffolding the M8→M9 device gate builds from, generated once by the pinned SDK
# (`make mobile-android-scaffold`) so its Gradle/AGP versions match `.flutter-version`.
/mobile/android/.gradle/
/mobile/android/app/build/
/mobile/android/local.properties
